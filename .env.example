# Credentials for running integration tests and the examples/demo command.
# Copy this file to .env and fill in real values. .env is gitignored.

SEVENTHINGS_BASE_URL=https://your-instance.seventhings.com
SEVENTHINGS_USERNAME=user@example.com
SEVENTHINGS_PASSWORD=your-password
SEVENTHINGS_CLIENT_ID=your-client-id

# Optional: use an existing OAuth authorization code + PKCE instead of password login.
# Codes are single-use; obtain a fresh code from your application's authorization flow.
# SEVENTHINGS_AUTH_CODE=
# SEVENTHINGS_CODE_VERIFIER=
# SEVENTHINGS_REDIRECT_URI=
